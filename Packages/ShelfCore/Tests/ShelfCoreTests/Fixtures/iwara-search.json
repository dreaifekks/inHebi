273c.mp4","mime":"video/mp4","size":243623011,"width":1920,"height":1080,"duration":191,"numThumbnails":16,"animatedPreview":true,"createdAt":"2026-10-09T09:10:24.000Z","updatedAt":"2026-10-09T09:11:54.000Z"},"customThumbnail":null,"user":{"id":"5bc9d1ed-bc94-4933-b60d-293a49d1eaca","name":"tikutiku194","username":"tiku194","status":"active","role":"user","followedBy":false,"following":false,"friend":false,"premium":false,"creatorProgram":true,"locale":null,"seenAt":"2026-10-13T14:16:06.000Z","avatar":{"id":"0b03761d-1688-46fe-9a72-7aa7b95ca69f","type":"image","path":"2026/02/21","name":"0b03761d-1688-46fe-9a72-7aa7b95ca69f.jpeg","mime":"image/jpeg","size":12591,"width":300,"height":300,"duration":null,"numThumbnails":null,"animatedPreview":false,"createdAt":"2026-02-21T12:10:53.000Z","updatedAt":"2026-02-21T12:10:57.000Z"},"createdAt":"2021-11-01T04:29:23.000Z","updatedAt":"2026-10-13T15:40:30.000Z"},"tags":[{"id":"mikumikudance","type":"category","sensitive":false},{"id":"zenless_zone_zero","type":"general","sensitive":false}],"siteId":"iwara","createdAt":"2026-10-09T09:11:54.000Z","updatedAt":"2026-10-13T16:11:46.000Z"},{"id":"75vhKKGI83dofX","slug":"snapping-or-ue5-mmd-4k","title":"【鸣潮 / 爱弥斯】Snapping | UE5 MMD 4K","body":"第一次拿 UE5 正儿八经搞完整 MMD，总算把这玩意儿折腾出来了。\n\n角色材质重新搓了一遍，NPR/PBR 混着来，皮肤、头发高光、眼睛挨个伺候。Sequencer 负责折腾镜头，动态天空负责白天变黑夜，最后扔进 MRQ 榨成 4K PNG，再丢达芬奇收拾残局。\n\n主打一个人可以不正经，渲染管线必须正经。\n\n至于为什么没穿衣服……\n\n真不是没准备。\n\n本来还想上布料模拟，结果外部解算和角色动画打得不可开交，FBX、ABC 来回折腾，衣服没穿上，技术债倒是穿了一身。\n\n目前已经把目光转向 Chaos Cloth 了，争取下次让衣服也参与一下演出。\n\n（至于最后脱不脱，那属于艺术决策，不归技术部门管。）\n\n第一次完整跑通 MMD → UE5 → 后期的流程，肯定还有不少毛病，后面继续优化材质、灯光和物理表现。\n\n技术交流欢迎，看片请自觉。\n\n制作： UE5 / Maya / Blender / DaVinci Resolve  \n输出： 4K / 30FPS  \nMusic： CHUNG HA - Snapping","status":"active","rating":"ecchi","private":false,"unlisted":false,"thumbnail":10,"embedUrl":null,"liked":false,"numLikes":89,"numViews":1031,"numComments":4,"file":{"id":"14b559a1-4ade-4011-b9c5-8023733be87e","type":"video","path":"2026/10/08","name":"14b559a1-4ade